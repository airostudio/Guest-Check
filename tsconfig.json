{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "api/**/*",
    "server/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "client",
    "dist",
    "server/prisma"
  ]
}
