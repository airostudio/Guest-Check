{
  "name": "guestcheck",
  "version": "1.0.0",
  "private": true,
  "description": "GuestCheck - Guest review platform for accommodation businesses",
  "scripts": {
    "vercel-build": "npx prisma generate --schema=server/prisma/schema.prisma && cd client && npm install && npm run build",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "prisma:migrate": "cd server && npx prisma migrate deploy",
    "prisma:studio": "cd server && npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13",
    "stripe": "^14.21.0",
    "twilio": "^5.0.3",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^6.4.14",
    "@types/node": "^20.12.2",
    "@types/uuid": "^9.0.8",
    "prisma": "^5.10.0",
    "typescript": "^5.4.3"
  }
}
