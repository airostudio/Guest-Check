# ──────────────────────────────────────────────────────────────────────────────
# GuestCheck — Vercel Environment Variables Reference
# ──────────────────────────────────────────────────────────────────────────────
# Add ALL of these in the Vercel dashboard:
#   Project → Settings → Environment Variables
#
# Select the environments each var applies to:
#   [x] Production  [x] Preview  [x] Development
# (Development is used when running `vercel dev` locally)
#
# NEVER commit real values to source control.
# This file documents variable names and formats only.
# ──────────────────────────────────────────────────────────────────────────────

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Supabase (REQUIRED — this is the live data path) ─────────────────────────
# The application talks to Supabase over HTTPS via PostgREST, NOT over a TCP
# Postgres connection. Supabase's free tier resolves its direct host on IPv6
# only, and Vercel's functions are IPv4 only, so TCP can never connect.
#
# Both of these are REQUIRED. Without them every API route returns a 500.
#   Supabase dashboard → Project Settings → API
#
# Project REST URL, no trailing slash:
SUPABASE_URL=https://YOURPROJECTREF.supabase.co
#
# The service_role key (NOT the anon key). Bypasses RLS — never expose it to
# the browser or commit a real value:
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Database URL (optional fallback) ─────────────────────────────────────────
# Only used to derive SUPABASE_URL when SUPABASE_URL is not set explicitly.
# Nothing opens a TCP connection to it.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://...

# ── Application ──────────────────────────────────────────────────────────────
# The public URL of your Vercel deployment (no trailing slash)
CLIENT_URL=https://guestcheck.vercel.app

# The public base URL for the API (used in webhook URL construction)
API_BASE_URL=https://guestcheck.vercel.app

# ── JWT (REQUIRED) ───────────────────────────────────────────────────────────
# Must be at least 32 characters. The app REFUSES TO START in production if
# this is missing or too short — it signs every session token, so a guessable
# value lets anyone forge a SUPER_ADMIN session.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-128-char-random-hex-string
JWT_EXPIRES_IN=7d

# ── Cron (REQUIRED for scheduled jobs) ───────────────────────────────────────
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`
# when it invokes /api/cron/*. If it is unset, those endpoints refuse to run in
# production (503) rather than being left publicly callable — each invocation
# emails every property admin, so an open endpoint is an email-blast amplifier.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-random-hex-string

# ── Waitlist notifications ───────────────────────────────────────────────────
# Where "coming soon" waitlist signups and new property applications are sent.
WAITLIST_NOTIFY_EMAIL=you@yourdomain.com

# ── Stripe ───────────────────────────────────────────────────────────────────
# From: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# From: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://guestcheck.vercel.app/api/subscriptions/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# From: https://dashboard.stripe.com/products
STRIPE_BASIC_PRICE_ID=price_...
STRIPE_PROFESSIONAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ── Twilio (Caller ID) ───────────────────────────────────────────────────────
# From: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ── Email (Resend — REQUIRED) ────────────────────────────────────────────────
# Email is delivered through Resend's HTTPS API (https://resend.com), NOT SMTP.
# Outbound SMTP from Vercel functions is unreliable; an HTTPS API is not.
#
# 1. Create an API key:  Resend dashboard → API Keys → Create
# 2. Verify the sending domain:  Resend dashboard → Domains → Add Domain,
#    then add the SPF/DKIM DNS records it gives you for guestcheck.site.
#    Sends are REJECTED by Resend until the domain shows "verified".
#
# Check it end to end after deploying:
#   GET /api/admin/email/status   (signed in as a super-admin)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The From address. Its domain MUST be verified in the Resend account above.
FROM_EMAIL=waitlist@guestcheck.site
FROM_NAME=Guest Check

# Optional — where replies land, since the From address is unmonitored.
REPLY_TO_EMAIL=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@guestcheck.io
# Used for seeding the first super-admin account
ADMIN_SECRET=your-strong-admin-bootstrap-secret
