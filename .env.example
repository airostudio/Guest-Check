# Database
POSTGRES_USER=guestcheck
POSTGRES_PASSWORD=guestcheck_secret
POSTGRES_DB=guestcheck

# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASIC_PRICE_ID=price_...
STRIPE_PROFESSIONAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Twilio (for caller ID lookup)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@guestcheck.io
FROM_NAME=GuestCheck

# Admin
ADMIN_EMAIL=admin@guestcheck.io
ADMIN_SECRET=change_this_admin_setup_secret

# Booking.com (Channel Manager API)
BOOKING_COM_API_KEY=
BOOKING_COM_PROPERTY_ID=

# Airbnb (OAuth)
AIRBNB_CLIENT_ID=
AIRBNB_CLIENT_SECRET=
