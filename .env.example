# GuestCheck — local development environment
# Copy to .env and fill in. See .env.vercel for the production reference.

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# The app reads and writes exclusively over HTTPS via PostgREST.
# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOURPROJECTREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: only used to derive SUPABASE_URL if the above is unset.
DATABASE_URL=postgresql://postgres:password@db.YOURPROJECTREF.supabase.co:5432/postgres

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Must be >= 32 chars. Production refuses to start without it.
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-secret-at-least-32-characters-long-please
JWT_EXPIRES_IN=7d

# ── Cron ──────────────────────────────────────────────────────────────────────
# Optional locally (cron endpoints are open in development).
# REQUIRED in production or they return 503.
CRON_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@guestcheck.io
FROM_NAME=GuestCheck

# Where waitlist signups and new property applications are emailed.
WAITLIST_NOTIFY_EMAIL=you@yourdomain.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@guestcheck.io
ADMIN_SECRET=
